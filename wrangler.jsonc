{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "murshid-website",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": [
      "/p",
      "/p/*",
      "/verify",
      "/verify/*",
      "/ar/companion/link",
      "/ar/companion/link/*",
      "/companion/link",
      "/companion/link/*",
      "/sitemap-specialists.xml"
    ]
  }
}
